#!/bin/sh
# athena worker status hook. Does nothing unless this session is an athena worker, or HQ (its resume command, and the
# request log: what the human types into HQ).
# It fires on every hook event of every Claude session, so a session outside the worktree root exits in shell:
# the root is ATHENA_WORKTREE_ROOT, else the one-line worktree-root file athena writes with config.json.
state="${ATHENA_STATE_DIR:-$HOME/.local/state/athena}"
[ -f "$state/ledger.jsonl" ] || { cat >/dev/null; exit 0; }
# HQ (ATHENA_ROLE=hq) goes through on SessionStart and UserPromptSubmit alone (hooks.json passes them as $1):
# hookstatus registers its resume command with herdr, and logs the human's prompt. Every other HQ event stays in shell.
if [ -z "${ATHENA_WORKER:-}" ] && ! { [ "${ATHENA_ROLE:-}" = hq ] && { [ "${1:-}" = SessionStart ] || [ "${1:-}" = UserPromptSubmit ]; }; }; then
	root="${ATHENA_WORKTREE_ROOT:-}"
	if [ -z "$root" ] && [ -f "$state/worktree-root" ] && ! [ "$state/config.json" -nt "$state/worktree-root" ]; then
		IFS= read -r root <"$state/worktree-root" || root=""
	fi
	if [ -n "$root" ]; then
		real_root=$(cd "$root" 2>/dev/null && pwd -P) || { cat >/dev/null; exit 0; }
		case "$(pwd -P)/" in
		"$real_root"/*) ;;
		*) cat >/dev/null; exit 0 ;;
		esac
	fi
	# No root known in shell (no config.json yet, or it changed since): hookstatus reads it from the config.
fi
here=$(cd "$(dirname "$0")/.." && pwd)
PYTHONPATH="$here" "${ATHENA_PYTHON:-/usr/bin/python3}" -m athena_lib.hookstatus 2>/dev/null
exit 0
