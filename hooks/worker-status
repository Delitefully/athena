#!/bin/sh
# cos worker status hook. Does nothing unless this session is a cos worker.
if [ -z "${COS_WORKER:-}" ]; then
	root="${COS_WORKTREE_ROOT:-$HOME/Developer/.worktrees}"
	real_root=$(cd "$root" 2>/dev/null && pwd -P) || { cat >/dev/null; exit 0; }
	case "$(pwd -P)/" in
	"$real_root"/*) ;;
	*) cat >/dev/null; exit 0 ;;
	esac
fi
here=$(cd "$(dirname "$0")/.." && pwd)
PYTHONPATH="$here" /usr/bin/python3 -m cos_lib.hookstatus 2>/dev/null
exit 0
